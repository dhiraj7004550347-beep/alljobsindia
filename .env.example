# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
NEXT_PUBLIC_SITE_URL=https://jobs.example.com
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optional public contact information
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional provider-neutral alert verification webhook (HTTPS in production)
ALERT_EMAIL_WEBHOOK_URL=
ALERT_EMAIL_FROM=

# Automation security and safe defaults
AUTOMATION_SECRET=
AUTOMATION_CRON_SECRET=
# Optional Vercel Cron alias; use the same random value as AUTOMATION_CRON_SECRET
CRON_SECRET=
AUTOMATION_DRY_RUN=true
AUTOMATION_ALLOW_WRITE_RUNS=false
AUTOMATION_ALLOW_MANUAL_DRAFTS=false
AUTOMATION_ALLOW_REVIEW_DECISIONS=false
AUTOMATION_ALLOW_AUTO_PUBLISH=false
AUTOMATION_MAX_SOURCES=10
AUTOMATION_MAX_JOBS=50
AUTOMATION_CONCURRENCY=3
AUTOMATION_TIMEOUT_MS=20000
AUTOMATION_MAX_HTML_BYTES=5000000
AUTOMATION_MAX_PDF_BYTES=15000000
AUTOMATION_MAX_PDFS_PER_SOURCE=3
AUTOMATION_MAX_NOTICE_ENRICHMENTS=12
AUTOMATION_MAX_SSC_API_PAGES=3
AUTOMATION_MAX_PDF_PAGES=40
AUTOMATION_MIN_DRAFT_CONFIDENCE=0.60
AUTOMATION_HIGH_CONFIDENCE=0.82
AUTOMATION_LOCK_MINUTES=30

# Optional AI extraction: both values are required
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Google Indexing API service account
GOOGLE_INDEXING_CLIENT_EMAIL=
GOOGLE_INDEXING_PRIVATE_KEY=

# Optional analytics and advertising
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_JOB_SLOT=
